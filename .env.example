# Copier ce fichier vers .env à la racine (pour docker-compose). Pour le
# backend, partir séparément de backend/.env.example et reporter les valeurs
# partagées (Postgres, MinIO, JWT_SECRET, ENCRYPTION_KEY, etc.) — ne pas
# remplacer backend/.env par ce fichier, car il lui manque des variables propres
# au backend telles que DATABASE_URL et JWT_REFRESH_SECRET. Appliquer ensuite
# `chmod 600` aux fichiers .env réels (et à .env.n8n si n8n est utilisé,
# voir .env.n8n.example) :
# un fichier de secrets lisible par tout compte du poste (permissions par
# défaut 644) donne accès à JWT_SECRET/ENCRYPTION_KEY/PAYMENT_WEBHOOK_SECRET
# et aux identifiants S3 à quiconque a un accès local non-privilégié à la
# machine — faille corrigée suite à l'audit sécurité. Pour un environnement
# partagé (CI, hébergeur), ne PAS copier ces fichiers du tout : utiliser le
# gestionnaire de secrets de la plateforme (variables d'environnement Render/
# Vercel marquées `sync: false`, secrets GitHub Actions...).
POSTGRES_USER=get_user
POSTGRES_PASSWORD=change-this-for-a-long-random-password
POSTGRES_DB=get_poc
# Redis est provisionné par docker-compose mais n'est utilisé par aucun
# module du backend à ce jour (le rate-limiting tourne en mémoire) —
# conservé pour un usage futur, pas nécessaire pour faire tourner l'app.
REDIS_PASSWORD=change-this-for-a-long-random-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-for-a-long-random-password
JWT_SECRET=change-this-for-a-long-random-jwt-secret
ENCRYPTION_KEY=replace-with-64-hex-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Fournisseur de paiement réel (Stripe, mode test ou réel — voir
# DEPLOYMENT.md). Dès que STRIPE_SECRET_KEY est définie, PaymentModule
# utilise StripePaymentProvider au lieu du mock, quel que soit
# ALLOW_MOCK_PAYMENT. Clé de test (sk_test_...) : créer un compte
# https://dashboard.stripe.com/register, aucune vérification d'entreprise
# nécessaire pour le mode test.
# STRIPE_SECRET_KEY=sk_test_...
# Généré par Stripe lors de la création d'un endpoint webhook
# (dashboard.stripe.com/test/webhooks -> Add endpoint -> URL =
# <APP_URL>/api/payments/webhook/stripe -> événements
# checkout.session.completed/async_payment_succeeded/async_payment_failed/expired),
# ou par `stripe listen` en local (voir DEPLOYMENT.md).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Clé partagée pour les appels machine-à-machine sous /api/integration/*
# (n8n aujourd'hui). Distincte de PAYMENT_WEBHOOK_SECRET : ce n'est pas une
# signature HMAC de payload, juste une clé statique comparée en temps
# constant (voir ServiceApiKeyGuard) — rotation et scope à traiter avant
# toute exposition au-delà d'un usage local.
INTEGRATION_API_KEY=replace-with-a-long-random-key
# Base URL de l'instance n8n à notifier des événements métier (ex:
# student.created). Non défini = les webhooks sortants sont un no-op
# silencieux (voir AuthService.notifyN8n) — sûr à laisser vide tant que
# l'hébergement n8n n'est pas décidé (docs/n8n/02-preparation-infrastructure.md).
N8N_WEBHOOK_BASE_URL=http://localhost:5678
# Envoyé en en-tête x-webhook-secret sur chaque appel vers N8N_WEBHOOK_BASE_URL ;
# le workflow n8n côté réception doit le vérifier avant tout traitement (voir
# docs/n8n/03-connecteurs-get.md — un webhook n8n sans ce contrôle accepte
# n'importe quel appelant capable de l'atteindre).
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
# Ne PAS activer avec l'architecture retenue (proxy Next.js /api, voir
# DEPLOYMENT.md et frontend/next.config.ts) : le navigateur ne parle jamais
# directement à ce backend, les cookies restent "premier parti"
# (SameSite=Lax) sans besoin de ce réglage. À réserver uniquement à un choix
# volontaire de l'architecture alternative "cookies cross-site" (frontend
# appelant directement ce backend, sans proxy) — et dans ce cas savoir que
# Safari (desktop et iOS) bloque ce cookie par défaut (ITP) même avec
# SameSite=None ; Secure : le login "réussit" mais le dashboard reste
# inaccessible sur ces navigateurs (voir auth.controller.ts:48-89).
# CROSS_SITE_COOKIES=true

# NODE_ENV=production doit être défini en production. Le réglage suivant ne
# doit JAMAIS être activé en production :
# ALLOW_DEMO_SEED=true       # autorise le seed de comptes de démonstration
# ALLOW_MOCK_PAYMENT n'a plus besoin d'être activé pour déployer (voir
# STRIPE_SECRET_KEY plus haut) — à ne garder que pour un environnement de
# démo/QA qui choisit explicitement de ne pas configurer Stripe, jamais un
# vrai déploiement :
# ALLOW_MOCK_PAYMENT=true    # autorise le fournisseur de paiement simulé

# ────────────────────────────────────────────
# Stockage de fichiers (S3-compatible : MinIO en local, Cloudflare R2 ou
# AWS S3 en déploiement). Voir DEPLOYMENT.md pour la marche à suivre.
# ────────────────────────────────────────────
APP_URL=http://localhost:3001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# MinIO exige le style "path" (endpoint/bucket/clé) ; un vrai bucket S3/R2
# fonctionne aussi bien en path-style, donc laisser à true est sûr partout.
S3_FORCE_PATH_STYLE=true
# Deux buckets : la plupart des fournisseurs S3-compatibles (MinIO en
# tête) n'honorent pas de façon fiable une ACL "public-read" posée sur un
# objet individuel — seule une politique au niveau du bucket est
# universellement respectée. Le bucket privé (documents, supports de
# cours, pièces jointes) ne doit JAMAIS avoir de politique de lecture
# publique ; le bucket public (avatars, logos, bannières) si.
S3_BUCKET=get-poc-uploads
S3_PUBLIC_BUCKET=get-poc-public
S3_ACCESS_KEY_ID=change-with-your-access-key
S3_SECRET_ACCESS_KEY=change-with-your-secret-key
# Base URL des fichiers publics ; pour MinIO : <S3_ENDPOINT>/<S3_PUBLIC_BUCKET>,
# pour R2 : l'URL publique du bucket.
S3_PUBLIC_URL=http://localhost:9000/get-poc-public
