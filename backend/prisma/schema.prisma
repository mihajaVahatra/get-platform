generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  roleId              String?
  role                Role?     @relation(fields: [roleId], references: [id])
  isActive            Boolean   @default(true)
  isVerified          Boolean   @default(false)
  lastLogin           DateTime?
  refreshToken        String?
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  gender              String    @default("MALE") // MALE, FEMALE
  theme               String    @default("system") // light, dark, system
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  student                  Student?
  teacher                  Teacher?
  schoolAdmin              SchoolAdmin?
  notifications            Notification[]
  auditLogs                AuditLog[]
  sentMessages             Message[]                 @relation("SentMessages")
  receivedMessages         Message[]                 @relation("ReceivedMessages")
  conversationParticipants ConversationParticipant[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model Student {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  birthDate        DateTime?
  cin              String?
  bacYear          Int?
  bacType          String?
  address          String?
  city             String?
  region           String?
  country          String    @default("Madagascar")
  bio              String?
  interests        String[]
  skills           String[]
  aspirations      String[]
  profileCompleted Boolean   @default(false)
  avatarUrl        String?

  // ════════════════════════════════════════════
  //  RELATION AVEC L'ÉCOLE (INSCRIPTION)
  // ════════════════════════════════════════════
  enrolledSchoolId String?
  enrolledSchool   School?             @relation("EnrolledStudents", fields: [enrolledSchoolId], references: [id])
  // Libellé calculé automatiquement depuis program/programLevel/academicYear.
  // Conservé pour les listes et filtres existants, il ne doit pas être saisi librement.
  enrolledYear     String?
  enrollmentStatus String              @default("ACTIVE")
  programId        String?
  program          SchoolProgram?      @relation(fields: [programId], references: [id])
  programLevel     Int?
  academicYearId   String?
  academicYear     SchoolAcademicYear? @relation(fields: [academicYearId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  documents    Document[]
  applications Application[]
  payments     Payment[]
  enrollments  CourseEnrollment[]
  submissions  AssignmentSubmission[]
  grades       Grade[]

  @@index([enrolledSchoolId])
  @@map("students")
}

model School {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  logo         String?
  type         String    @default("PRIVATE")
  address      String?
  city         String
  region       String?
  country      String    @default("Madagascar")
  contactEmail String?
  contactPhone String?
  website      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // ════════════════════════════════════════════
  //  ÉTUDIANTS INSCRITS
  // ════════════════════════════════════════════
  enrolledStudents Student[] @relation("EnrolledStudents")

  admins             SchoolAdmin[]
  offers             Offer[]
  requirements       SchoolRequirement[]
  teacherAssignments TeacherSchool[]
  courses            Course[]
  announcements      Announcement[]
  programs           SchoolProgram[]
  academicYears      SchoolAcademicYear[]
  subjects           SchoolSubject[]
  competitions       Competition[]

  subscription SchoolSubscription?
  compliance   ComplianceCheck[]

  @@map("schools")
}

model SchoolProgram {
  id            String    @id @default(uuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  diploma       String
  durationYears Int
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  students      Student[]
  offers        Offer[]
  Course        Course[]
  competitions  Competition[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("school_programs")
}

model SchoolAcademicYear {
  id                 String    @id @default(uuid())
  schoolId           String
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label              String
  enrollmentOpensAt  DateTime
  enrollmentClosesAt DateTime
  isCurrent          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  students           Student[]

  @@unique([schoolId, label])
  @@index([schoolId, isCurrent])
  @@map("school_academic_years")
}

model Competition {
  id                   String         @id @default(uuid())
  schoolId             String
  school               School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programId            String?
  program              SchoolProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  name                 String
  description          String?
  examDate             DateTime?
  registrationDeadline DateTime?
  capacity             Int?
  status               String         @default("PLANNED")
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  @@index([schoolId, status])
  @@map("competitions")
}

model FinancialPartner {
  id           String    @id @default(uuid())
  name         String
  description  String?
  type         String    @default("OTHER")
  contactEmail String?
  contactPhone String?
  website      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([type])
  @@map("financial_partners")
}

model SchoolAdmin {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("school_admins")
}

model Teacher {
  id          String          @id @default(uuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  avatarUrl   String?
  phone       String?
  assignments TeacherSchool[]
  courses     Course[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("teachers")
}

/// Affectation d'un professeur dans un établissement. Un professeur peut
/// enseigner dans plusieurs établissements, avec une spécialité propre à chacun.
model TeacherSchool {
  id         String                 @id @default(uuid())
  teacherId  String
  teacher    Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department String?
  specialty  String?
  isActive   Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  subjects   TeacherSchoolSubject[]

  @@unique([teacherId, schoolId])
  @@index([schoolId, isActive])
  @@map("teacher_schools")
}

model SchoolSubject {
  id                    String                 @id @default(uuid())
  schoolId              String
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                  String
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  teacherQualifications TeacherSchoolSubject[]
  courses               Course[]

  @@unique([schoolId, name])
  @@map("school_subjects")
}

model TeacherSchoolSubject {
  id              String        @id @default(uuid())
  teacherSchoolId String
  teacherSchool   TeacherSchool @relation(fields: [teacherSchoolId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherSchoolId, subjectId])
  @@map("teacher_school_subjects")
}

model Course {
  id           String             @id @default(uuid())
  schoolId     String
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  code         String
  title        String
  description  String?
  level        String
  subjectId    String?
  subject      SchoolSubject?     @relation(fields: [subjectId], references: [id])
  programId    String?
  program      SchoolProgram?     @relation(fields: [programId], references: [id])
  programLevel Int?
  group        String?
  credits      Int                @default(0)
  room         String?
  schedule     String?
  isPublished  Boolean            @default(true)
  welcomeMessage     String?
  allowGroupMessages Boolean      @default(true)
  notifyOnPublish    Boolean      @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  chapters     CourseChapter[]
  enrollments  CourseEnrollment[]
  evaluations  Evaluation[]
  assignments  Assignment[]
  slots        CourseSlot[]
  announcements Announcement[]

  @@unique([schoolId, code, group])
  @@index([teacherId, isPublished])
  @@map("courses")
}

model CourseSlot {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  room      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, dayOfWeek, startTime, endTime, room])
  @@index([courseId])
  @@index([dayOfWeek, room, startTime, endTime])
  @@map("course_slots")
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

model CourseChapter {
  id          String           @id @default(uuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int
  isPublished Boolean          @default(false)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resources   CourseResource[]

  @@unique([courseId, position])
  @@map("course_chapters")
}

model CourseResource {
  id        String        @id @default(uuid())
  chapterId String
  chapter   CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  url       String
  type      String
  createdAt DateTime      @default(now())

  @@index([chapterId])
  @@map("course_resources")
}

model Evaluation {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  type        String
  scheduledAt DateTime?
  coefficient Float     @default(1)
  createdAt   DateTime  @default(now())
  grades      Grade[]

  @@index([courseId, scheduledAt])
  @@map("evaluations")
}

model Assignment {
  id           String                 @id @default(uuid())
  courseId     String
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  instructions String?
  dueAt        DateTime?
  publishedAt  DateTime?
  createdAt    DateTime               @default(now())
  submissions  AssignmentSubmission[]

  @@index([courseId, dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentUrl   String?
  submittedAt  DateTime   @default(now())
  grade        Float?
  feedback     String?

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Grade {
  id           String     @id @default(uuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  value        Float
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([evaluationId, studentId])
  @@index([studentId])
  @@map("grades")
}

model SchoolSubscription {
  id            String    @id @default(uuid())
  schoolId      String    @unique
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan          String
  startDate     DateTime  @default(now())
  endDate       DateTime?
  isActive      Boolean   @default(true)
  amount        Float
  paymentStatus String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("school_subscriptions")
}

model Offer {
  id                  String         @id @default(uuid())
  schoolId            String
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title               String
  slug                String         @unique
  description         String?
  diploma             String
  programId           String?
  program             SchoolProgram? @relation(fields: [programId], references: [id])
  duration            Int
  tuitionFees         Float
  currency            String         @default("MGA")
  prerequisites       String[]
  capacity            Int?
  applicationDeadline DateTime?
  academicYear        String
  isOpen              Boolean        @default(true)
  isFeatured          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  applications Application[]
  requirements OfferRequirement[]

  @@index([schoolId, isOpen, createdAt])
  @@map("offers")
}

model SchoolRequirement {
  id          String             @id @default(uuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String             @default("DOCUMENT")
  diploma     String?
  isRequired  Boolean            @default(true)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  offers      OfferRequirement[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("school_requirements")
}

model OfferRequirement {
  offerId       String
  offer         Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   SchoolRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  isRequired    Boolean           @default(true)

  @@id([offerId, requirementId])
  @@map("offer_requirements")
}

model Application {
  id             String    @id @default(uuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offerId        String
  offer          Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING")
  score          Float?
  testResults    Json?
  interviewDate  DateTime?
  interviewLink  String?
  decisionDate   DateTime?
  decisionReason String?
  submittedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  timeline ApplicationTimeline[]
  payments Payment[]

  @@unique([studentId, offerId])
  @@index([studentId, status])
  @@index([offerId, status])
  @@map("applications")
}

model ApplicationTimeline {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String
  note          String?
  createdBy     String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@map("application_timelines")
}

model Payment {
  id            String       @id @default(uuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String       @default("MGA")
  method        String
  status        String       @default("PENDING")
  reference     String       @unique
  providerRef   String?
  commission    Float
  receiptUrl    String?
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  transaction Transaction?
  refund      Refund?

  @@index([studentId, status])
  @@index([reference])
  @@map("payments")
}

model Transaction {
  id                    String    @id @default(uuid())
  paymentId             String    @unique
  payment               Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type                  String
  amount                Float
  provider              String
  providerTransactionId String?
  status                String
  rawResponse           Json?
  createdAt             DateTime  @default(now())
  completedAt           DateTime?

  @@map("transactions")
}

model Refund {
  id          String    @id @default(uuid())
  paymentId   String    @unique
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String?
  status      String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("refunds")
}

model Document {
  id         String    @id @default(uuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type       String
  name       String
  fileUrl    String
  fileSize   Int
  mimeType   String
  isVerified Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  @@index([studentId, type])
  @@map("documents")
}

model Notification {
  id                    String                 @id @default(uuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  String
  title                 String
  body                  String
  data                  Json?
  isRead                Boolean                @default(false)
  readAt                DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime               @default(now())
  announcementRecipient AnnouncementRecipient?

  @@index([userId, isRead])
  @@map("notifications")
}

model Announcement {
  id            String                  @id @default(uuid())
  schoolId      String
  school        School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorId      String
  title         String
  body          String
  targetType    String
  courseId      String?
  course        Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)
  targetClasses String[]                @default([])
  createdAt     DateTime                @default(now())
  recipients    AnnouncementRecipient[]

  @@index([schoolId, createdAt])
  @@index([courseId, createdAt])
  @@map("announcements")
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  notificationId String       @unique
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_recipients")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User         @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject        String
  body           String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([recipientId, isRead, createdAt])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model Conversation {
  id            String                    @id @default(uuid())
  directKey     String                    @unique
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@map("conversation_participants")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String?
  body      String
  type      String
  variables String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model MinistryReport {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String
  period      String
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  fileUrl     String?
  generatedBy String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("ministry_reports")
}

model ComplianceCheck {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  checkType String
  status    String
  score     Float?
  remarks   String?
  checkedBy String?
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([schoolId, checkedAt])
  @@map("compliance_checks")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  resourceId   String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Image {
  id         String   @id @default(uuid())
  url        String
  type       String // AVATAR, LOGO, ILLUSTRATION, BANNER
  entityType String // STUDENT, SCHOOL, ADMIN, MINISTRY, OFFER, SYSTEM
  entityId   String?
  mimeType   String
  size       Int
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@map("images")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  isEncrypted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
