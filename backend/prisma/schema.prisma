generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  roleId              String?
  role                Role?     @relation(fields: [roleId], references: [id])
  isActive            Boolean   @default(true)
  isVerified          Boolean   @default(false)
  lastLogin           DateTime?
  refreshToken        String?
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  // Incrémenté à chaque déconnexion explicite ; les JWT signés portent la
  // valeur en vigueur au moment de leur émission (`sessionVersion` dans le
  // payload). Un token dont la valeur ne correspond plus à celle en base
  // est rejeté — c'est le mécanisme de révocation de session côté serveur
  // (un JWT stateless ne peut normalement pas être invalidé avant son
  // expiration naturelle).
  sessionVersion      Int       @default(0)
  gender              String    @default("MALE") // MALE, FEMALE
  theme               String    @default("system") // light, dark, system
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  student                  Student?
  teacher                  Teacher?
  schoolAdmin              SchoolAdmin?
  notifications            Notification[]
  auditLogs                AuditLog[]
  sentMessages             Message[]                 @relation("SentMessages")
  receivedMessages         Message[]                 @relation("ReceivedMessages")
  conversationParticipants ConversationParticipant[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model Student {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  birthDate        DateTime?
  cin              String?
  bacYear          Int?
  bacType          String?
  address          String?
  city             String?
  region           String?
  country          String    @default("Madagascar")
  bio              String?
  interests        String[]
  skills           String[]
  aspirations      String[]
  profileCompleted Boolean   @default(false)
  avatarUrl        String?

  // ════════════════════════════════════════════
  //  RELATION AVEC L'ÉCOLE (INSCRIPTION)
  // ════════════════════════════════════════════
  // Un étudiant peut être inscrit activement dans plusieurs établissements
  // à la fois (double diplôme, cursus parallèle) : voir StudentEnrollment,
  // une ligne par (étudiant, école), plutôt qu'un pointeur unique.
  schoolEnrollments StudentEnrollment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  documents    Document[]
  applications Application[]
  payments     Payment[]
  enrollments  CourseEnrollment[]
  submissions  AssignmentSubmission[]
  grades       Grade[]

  @@map("students")
}

/// Inscription d'un étudiant dans un établissement. Un étudiant peut être
/// inscrit activement dans plusieurs établissements simultanément (double
/// diplôme, cursus parallèle) : une ligne par (étudiant, école), sur le
/// même principe que TeacherSchool pour les professeurs.
model StudentEnrollment {
  id             String             @id @default(uuid())
  studentId      String
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId       String
  school         School             @relation("EnrolledStudents", fields: [schoolId], references: [id], onDelete: Cascade)
  programId      String
  program        SchoolProgram      @relation(fields: [programId], references: [id])
  programLevel   Int
  academicYearId String
  academicYear   SchoolAcademicYear @relation(fields: [academicYearId], references: [id])
  // Libellé calculé automatiquement depuis program/programLevel/academicYear.
  // Conservé pour les listes et filtres existants, il ne doit pas être saisi librement.
  enrolledYear   String
  status         String             @default("ACTIVE") // ACTIVE | WITHDRAWN | GRADUATED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, schoolId])
  @@index([schoolId, status])
  @@map("student_enrollments")
}

model School {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  logo         String?
  type         String    @default("PRIVATE")
  address      String?
  city         String
  region       String?
  country      String    @default("Madagascar")
  contactEmail String?
  contactPhone String?
  website      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // ════════════════════════════════════════════
  //  ÉTUDIANTS INSCRITS
  // ════════════════════════════════════════════
  enrolledStudents StudentEnrollment[] @relation("EnrolledStudents")

  admins             SchoolAdmin[]
  offers             Offer[]
  requirements       SchoolRequirement[]
  teacherAssignments TeacherSchool[]
  courses            Course[]
  announcements      Announcement[]
  programs           SchoolProgram[]
  academicYears      SchoolAcademicYear[]
  subjects           SchoolSubject[]
  competitions       Competition[]

  subscription SchoolSubscription?
  compliance   ComplianceCheck[]

  // ════════════════════════════════════════════
  //  PLANIFICATION (moteur d'emploi du temps)
  // ════════════════════════════════════════════
  rooms                 Room[]
  schoolClasses         SchoolClass[]
  subjectRequirements   SubjectRequirement[]
  timeSlots             SchoolTimeSlot[]
  travelBufferAsSchoolA TeacherTravelBuffer[] @relation("TravelBufferSchoolA")
  travelBufferAsSchoolB TeacherTravelBuffer[] @relation("TravelBufferSchoolB")

  @@map("schools")
}

model SchoolProgram {
  id            String              @id @default(uuid())
  schoolId      String
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  diploma       String
  durationYears Int
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  enrollments   StudentEnrollment[]
  offers        Offer[]
  Course        Course[]
  competitions  Competition[]
  schoolClasses SchoolClass[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("school_programs")
}

model SchoolAcademicYear {
  id                 String              @id @default(uuid())
  schoolId           String
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label              String
  enrollmentOpensAt  DateTime
  enrollmentClosesAt DateTime
  isCurrent          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  enrollments        StudentEnrollment[]

  @@unique([schoolId, label])
  @@index([schoolId, isCurrent])
  @@map("school_academic_years")
}

model Competition {
  id                   String         @id @default(uuid())
  schoolId             String
  school               School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programId            String?
  program              SchoolProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  name                 String
  description          String?
  examDate             DateTime?
  registrationDeadline DateTime?
  capacity             Int?
  status               String         @default("PLANNED")
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  @@index([schoolId, status])
  @@map("competitions")
}

model FinancialPartner {
  id           String    @id @default(uuid())
  name         String
  description  String?
  type         String    @default("OTHER")
  logo         String?
  contactEmail String?
  contactPhone String?
  website      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([type])
  @@map("financial_partners")
}

model LandingNewsPost {
  id           String    @id @default(uuid())
  type         String    @default("ACTUALITÉ")
  title        String
  body         String
  imageUrl     String?
  isPublished  Boolean   @default(true)
  displayOrder Int       @default(0)
  publishedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([isPublished, displayOrder])
  @@map("landing_news_posts")
}

model SchoolAdmin {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("school_admins")
}

model Teacher {
  id                 String                @id @default(uuid())
  userId             String                @unique
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String?
  lastName           String?
  avatarUrl          String?
  phone              String?
  assignments        TeacherSchool[]
  courses            Course[]
  subjectAssignments TeacherAssignment[]
  courseSlots        CourseSlot[]
  availabilities     TeacherAvailability[]
  travelBuffers      TeacherTravelBuffer[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@map("teachers")
}

/// Affectation d'un professeur dans un établissement. Un professeur peut
/// enseigner dans plusieurs établissements, avec une spécialité propre à chacun.
model TeacherSchool {
  id         String                 @id @default(uuid())
  teacherId  String
  teacher    Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department String?
  specialty  String?
  isActive   Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  subjects   TeacherSchoolSubject[]

  @@unique([teacherId, schoolId])
  @@index([schoolId, isActive])
  @@map("teacher_schools")
}

model SchoolSubject {
  id                    String                 @id @default(uuid())
  schoolId              String
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                  String
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  teacherQualifications TeacherSchoolSubject[]
  courses               Course[]
  requirements          SubjectRequirement[]

  @@unique([schoolId, name])
  @@map("school_subjects")
}

model TeacherSchoolSubject {
  id              String        @id @default(uuid())
  teacherSchoolId String
  teacherSchool   TeacherSchool @relation(fields: [teacherSchoolId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherSchoolId, subjectId])
  @@map("teacher_school_subjects")
}

// ════════════════════════════════════════════
//  MOTEUR DE PLANIFICATION — PHASE 1 (fondations)
// ════════════════════════════════════════════

/// Année scolaire centrale (créée par l'administrateur plateforme), période
/// de référence pour les classes et les besoins horaires de chaque école.
/// Distincte de SchoolAcademicYear (par école, orientée admissions).
model AcademicYear {
  id        String   @id @default(uuid())
  label     String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolClasses SchoolClass[]
  requirements  SubjectRequirement[]

  @@map("academic_years")
}

model Room {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?
  type      String   @default("STANDARD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("rooms")
}

model SchoolClass {
  id             String         @id @default(uuid())
  schoolId       String
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  programId      String?
  program        SchoolProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  name           String
  level          Int?
  studentCount   Int?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  requirements SubjectRequirement[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId])
  @@map("school_classes")
}

/// Le besoin ("cette classe a besoin de N h/semaine de cette matière"),
/// volontairement découplé de l'affectation prof (TeacherAssignment) pour
/// pouvoir définir les besoins avant de savoir qui les couvre.
model SubjectRequirement {
  id             String        @id @default(uuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  classId        String
  schoolClass    SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        SchoolSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  hoursPerWeek   Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignment TeacherAssignment?
  course     Course?

  @@unique([classId, subjectId])
  @@map("subject_requirements")
}

/// Le prof qui couvre un besoin donné. Le prof doit déjà être qualifié pour
/// la matière dans cette école (TeacherSchoolSubject), vérifié en service.
model TeacherAssignment {
  id                   String             @id @default(uuid())
  subjectRequirementId String             @unique
  subjectRequirement   SubjectRequirement @relation(fields: [subjectRequirementId], references: [id], onDelete: Cascade)
  teacherId            String
  teacher              Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now())

  @@map("teacher_assignments")
}

/// Grille des créneaux valides propre à chaque école (indépendante de
/// l'année scolaire — la grille horaire change rarement).
model SchoolTimeSlot {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([schoolId, dayOfWeek, startTime, endTime])
  @@index([schoolId, isActive])
  @@map("school_time_slots")
}

// ════════════════════════════════════════════
//  MOTEUR DE PLANIFICATION — PHASE 2 (disponibilités, confidentialité)
// ════════════════════════════════════════════

/// Indisponibilité déclarée par le prof — récurrente (dayOfWeek) ou
/// ponctuelle (date). Par défaut un prof est considéré disponible ; ce
/// modèle liste les exceptions, pas les disponibilités positives.
model TeacherAvailability {
  id        String    @id @default(uuid())
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek Int?
  date      DateTime?
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime  @default(now())

  @@index([teacherId])
  @@map("teacher_availabilities")
}

/// Temps de trajet minimal déclaré par le prof entre deux de ses écoles.
/// schoolAId/schoolBId toujours normalisés (ordre alphabétique) en service.
model TeacherTravelBuffer {
  id            String   @id @default(uuid())
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolAId     String
  schoolA       School   @relation("TravelBufferSchoolA", fields: [schoolAId], references: [id], onDelete: Cascade)
  schoolBId     String
  schoolB       School   @relation("TravelBufferSchoolB", fields: [schoolBId], references: [id], onDelete: Cascade)
  minutesBuffer Int
  createdAt     DateTime @default(now())

  @@unique([teacherId, schoolAId, schoolBId])
  @@map("teacher_travel_buffers")
}

model Course {
  id                   String              @id @default(uuid())
  schoolId             String
  school               School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId            String
  teacher              Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  code                 String
  title                String
  description          String?
  level                String
  subjectId            String?
  subject              SchoolSubject?      @relation(fields: [subjectId], references: [id])
  programId            String?
  program              SchoolProgram?      @relation(fields: [programId], references: [id])
  programLevel         Int?
  group                String?
  credits              Int                 @default(0)
  room                 String?
  schedule             String?
  isPublished          Boolean             @default(true)
  welcomeMessage       String?
  allowGroupMessages   Boolean             @default(true)
  notifyOnPublish      Boolean             @default(true)
  // Renseigné uniquement pour les cours créés par le moteur de génération
  // automatique (Phase 3) — permet de retrouver/compléter le cours d'un
  // besoin donné sans dupliquer, et de vérifier qu'une classe n'a pas deux
  // cours en même temps (via subjectRequirement.classId).
  subjectRequirementId String?             @unique
  subjectRequirement   SubjectRequirement? @relation(fields: [subjectRequirementId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  chapters             CourseChapter[]
  enrollments          CourseEnrollment[]
  evaluations          Evaluation[]
  assignments          Assignment[]
  slots                CourseSlot[]
  announcements        Announcement[]

  @@unique([schoolId, code, group])
  @@index([teacherId, isPublished])
  @@map("courses")
}

model CourseSlot {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Dénormalisé depuis course.teacherId, pour permettre une contrainte
  // d'exclusion anti-double-réservation au niveau base (voir migration).
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  room      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, dayOfWeek, startTime, endTime, room])
  @@index([courseId])
  @@index([dayOfWeek, room, startTime, endTime])
  @@index([teacherId, dayOfWeek])
  @@map("course_slots")
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

model CourseChapter {
  id          String           @id @default(uuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int
  isPublished Boolean          @default(false)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resources   CourseResource[]

  @@unique([courseId, position])
  @@map("course_chapters")
}

model CourseResource {
  id        String        @id @default(uuid())
  chapterId String
  chapter   CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  url       String
  type      String
  createdAt DateTime      @default(now())

  @@index([chapterId])
  @@map("course_resources")
}

model Evaluation {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  type        String
  scheduledAt DateTime?
  coefficient Float     @default(1)
  createdAt   DateTime  @default(now())
  grades      Grade[]

  @@index([courseId, scheduledAt])
  @@map("evaluations")
}

model Assignment {
  id           String                 @id @default(uuid())
  courseId     String
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  instructions String?
  dueAt        DateTime?
  publishedAt  DateTime?
  createdAt    DateTime               @default(now())
  submissions  AssignmentSubmission[]

  @@index([courseId, dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentUrl   String?
  submittedAt  DateTime   @default(now())
  grade        Float?
  feedback     String?

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Grade {
  id           String     @id @default(uuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  value        Float
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([evaluationId, studentId])
  @@index([studentId])
  @@map("grades")
}

model SchoolSubscription {
  id            String    @id @default(uuid())
  schoolId      String    @unique
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan          String
  startDate     DateTime  @default(now())
  endDate       DateTime?
  isActive      Boolean   @default(true)
  amount        Float
  paymentStatus String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("school_subscriptions")
}

model Offer {
  id                  String         @id @default(uuid())
  schoolId            String
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title               String
  slug                String         @unique
  description         String?
  diploma             String
  programId           String?
  program             SchoolProgram? @relation(fields: [programId], references: [id])
  duration            Int
  tuitionFees         Float
  currency            String         @default("MGA")
  prerequisites       String[]
  capacity            Int?
  applicationDeadline DateTime?
  academicYear        String
  isOpen              Boolean        @default(true)
  isFeatured          Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  applications Application[]
  requirements OfferRequirement[]

  @@index([schoolId, isOpen, createdAt])
  @@map("offers")
}

model SchoolRequirement {
  id          String             @id @default(uuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String             @default("DOCUMENT")
  diploma     String?
  isRequired  Boolean            @default(true)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  offers      OfferRequirement[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("school_requirements")
}

model OfferRequirement {
  offerId       String
  offer         Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   SchoolRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  isRequired    Boolean           @default(true)

  @@id([offerId, requirementId])
  @@map("offer_requirements")
}

model Application {
  id             String    @id @default(uuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offerId        String
  offer          Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING")
  score          Float?
  testResults    Json?
  interviewDate  DateTime?
  interviewLink  String?
  decisionDate   DateTime?
  decisionReason String?
  submittedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  timeline ApplicationTimeline[]
  payments Payment[]

  @@unique([studentId, offerId])
  @@index([studentId, status])
  @@index([offerId, status])
  @@map("applications")
}

model ApplicationTimeline {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String
  note          String?
  createdBy     String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@map("application_timelines")
}

model Payment {
  id            String       @id @default(uuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String       @default("MGA")
  method        String
  status        String       @default("PENDING")
  reference     String       @unique
  providerRef   String?
  commission    Float
  receiptUrl    String?
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  transaction Transaction?
  refund      Refund?

  @@index([studentId, status])
  @@index([reference])
  @@map("payments")
}

model Transaction {
  id                    String    @id @default(uuid())
  paymentId             String    @unique
  payment               Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type                  String
  amount                Float
  provider              String
  providerTransactionId String?
  status                String
  rawResponse           Json?
  createdAt             DateTime  @default(now())
  completedAt           DateTime?

  @@map("transactions")
}

model Refund {
  id          String    @id @default(uuid())
  paymentId   String    @unique
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String?
  status      String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("refunds")
}

model Document {
  id         String    @id @default(uuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type       String
  name       String
  fileUrl    String
  fileSize   Int
  mimeType   String
  isVerified Boolean   @default(false)
  verifiedBy String?
  verifiedAt DateTime?
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  @@index([studentId, type])
  @@map("documents")
}

model Notification {
  id                    String                 @id @default(uuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  String
  title                 String
  body                  String
  data                  Json?
  isRead                Boolean                @default(false)
  readAt                DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime               @default(now())
  announcementRecipient AnnouncementRecipient?

  @@index([userId, isRead])
  @@map("notifications")
}

model Announcement {
  id            String                  @id @default(uuid())
  schoolId      String
  school        School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorId      String
  title         String
  body          String
  targetType    String
  imageUrl      String?
  courseId      String?
  course        Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)
  targetClasses String[]                @default([])
  createdAt     DateTime                @default(now())
  recipients    AnnouncementRecipient[]

  @@index([schoolId, createdAt])
  @@index([courseId, createdAt])
  @@map("announcements")
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  notificationId String       @unique
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_recipients")
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User                @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject        String?
  body           String
  isRead         Boolean             @default(false)
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  attachments    MessageAttachment[]

  @@index([recipientId, isRead, createdAt])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  mimeType  String
  size      Int
  kind      String
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model Conversation {
  id            String                    @id @default(uuid())
  directKey     String                    @unique
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@map("conversation_participants")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String?
  body      String
  type      String
  variables String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model MinistryReport {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String
  period      String
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  fileUrl     String?
  generatedBy String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("ministry_reports")
}

model ComplianceCheck {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  checkType String
  status    String
  score     Float?
  remarks   String?
  checkedBy String?
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([schoolId, checkedAt])
  @@map("compliance_checks")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  resourceId   String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Image {
  id         String   @id @default(uuid())
  url        String
  type       String // AVATAR, LOGO, ILLUSTRATION, BANNER
  entityType String // STUDENT, SCHOOL, ADMIN, MINISTRY, OFFER, SYSTEM
  entityId   String?
  mimeType   String
  size       Int
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@map("images")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  isEncrypted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
