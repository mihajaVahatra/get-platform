DATABASE_URL="postgresql://get_user:change-this-for-a-long-random-password@localhost:5432/get_poc?schema=public"
JWT_SECRET=change-this-for-a-long-random-jwt-secret
JWT_REFRESH_SECRET=change-this-for-a-different-long-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PORT=3001
FRONTEND_URL=http://localhost:3000
ENCRYPTION_KEY=replace-with-64-hex-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# URL publique de ce backend, utilisée pour construire les liens
# /uploads/... des fichiers protégés (documents, supports de cours,
# pièces jointes) qui passent par protected-uploads.middleware.ts.
APP_URL=http://localhost:3001

# Stockage S3-compatible (MinIO en local, via docker-compose à la racine du
# dépôt). Les identifiants ci-dessous correspondent à MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD du .env racine — le bucket doit être créé une fois via
# la console MinIO (http://localhost:9001) ou `mc mb`, voir DEPLOYMENT.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=get-poc-uploads
S3_PUBLIC_BUCKET=get-poc-public
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-this-for-a-long-random-password
S3_PUBLIC_URL=http://localhost:9000/get-poc-public

# Clé de service pour /api/integration/* (voir docs/n8n/) — optionnel tant
# que n8n n'est pas utilisé en local.
INTEGRATION_API_KEY=replace-with-a-long-random-key
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Envoi d'emails transactionnels (vérification email, réinitialisation de mot
# de passe...) via SendGrid — voir NotificationService.dispatchEmail. Sans
# SENDGRID_API_KEY, les emails sont simplement journalisés en console (mode
# dev), aucun compte SendGrid n'est nécessaire pour développer en local.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@get.mg
SENDGRID_FROM_NAME=GET

# Garde-fous à ne JAMAIS activer en production (voir seed.ts et
# payment.module.ts) :
# ALLOW_DEMO_SEED=true
# ALLOW_MOCK_PAYMENT=true
